{
  "name": "never87-novel-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Never87 Novel Studio - a browser-based AI novel writing workbench",
  "author": "Never87",
  "license": "MIT",
  "homepage": "https://never87.github.io/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "tsc -b --noEmit",
    "verify": "node scripts/p2a-verify.cjs",
    "verify:narrative": "node scripts/p2b-verify.cjs",
    "verify:narrative:ui": "node scripts/p2b-ui-verify.cjs",
    "verify:outline": "node scripts/p3-verify.cjs",
    "verify:outline:ui": "node scripts/p3-ui-verify.cjs",
    "verify:editor": "node scripts/p4-autosave-unit.cjs",
    "verify:markdown": "node scripts/p4-markdown-unit.cjs",
    "verify:writing": "node scripts/p4-verify.cjs",
    "verify:writing:ui": "node scripts/p4-ui-verify.cjs",
    "verify:ai": "node scripts/p5-verify.cjs",
    "verify:ai:ui": "node scripts/p5-ui-verify.cjs",
    "verify:prompt": "node scripts/p6-verify.cjs",
    "verify:prompt:ui": "node scripts/p6-ui-verify.cjs"
  },
  "dependencies": {
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "dexie": "^4.4.7",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zod": "^3.24.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.7"
  }
}
